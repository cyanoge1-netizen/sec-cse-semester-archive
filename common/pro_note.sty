\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pro_note}[2026/09/21 v2.0 SEC/SUST Professional XeLaTeX Note & Handbook Package]

% ==============================================================================
% 1. CORE PACKAGES & GEOMETRY
% ==============================================================================
\RequirePackage[a4paper,margin=1.8cm,headheight=26pt,top=2.2cm,bottom=2.0cm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=1.4em,topsep=2pt,itemsep=2pt}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{tikz}
\usetikzlibrary{shapes,backgrounds,arrows.meta,positioning,calc}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{lastpage}
\RequirePackage{listings}

% ==============================================================================
% 2. SIGNATURE COLOR PALETTE (Navy / Teal / Gold / Coral / Dark Slate)
% ==============================================================================
\definecolor{navy}{HTML}{0B2545}
\definecolor{teal}{HTML}{147D75}
\definecolor{gold}{HTML}{C9A227}
\definecolor{lightteal}{HTML}{E7F3F2}
\definecolor{lightgold}{HTML}{FBF3DD}
\definecolor{coral}{HTML}{C0392B}
\definecolor{lightcoral}{HTML}{FDEDEC}
\definecolor{darkslate}{HTML}{1E293B}

% Aliases for semantic interoperability
\definecolor{PrimaryColor}{HTML}{0B2545}
\definecolor{SecondaryColor}{HTML}{1E293B}
\definecolor{AccentColor}{HTML}{147D75}
\definecolor{GoldColor}{HTML}{C9A227}
\definecolor{WarningColor}{HTML}{C0392B}

% ==============================================================================
% 3. TYPOGRAPHY & HYPERLINKS
% ==============================================================================
\setmainfont{Latin Modern Roman}[
    SmallCapsFont = Latin Modern Roman Caps,
    Ligatures     = TeX
]
\setsansfont{Latin Modern Sans}[
    Ligatures = TeX
]
\setmonofont{Latin Modern Mono}[
    Scale = MatchLowercase
]

\RequirePackage[colorlinks=true,linkcolor=teal,urlcolor=teal,citecolor=navy]{hyperref}
\RequirePackage{bookmark}

\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}

% ==============================================================================
% 4. TABLE OF CONTENTS STYLING (titletoc)
% ==============================================================================
\titlecontents{section}[0pt]
  {\addvspace{5pt}\bfseries\small\color{navy}}
  {\contentslabel[\thecontentslabel]{1.8em}}
  {}
  {\titlerule*[0.5pc]{\color{gray!60}.}\bfseries\color{teal}\contentspage}

\titlecontents{subsection}[2.2em]
  {\addvspace{1.5pt}\normalfont\footnotesize\color{darkslate}}
  {\contentslabel[\thecontentslabel]{2.2em}}
  {}
  {\titlerule*[0.5pc]{\color{gray!35}.}\color{teal!80!black}\contentspage}

% ==============================================================================
% 5. SECTION FORMATTING (titlesec)
% ==============================================================================
\titleformat{\section}
  {\bfseries\Large\color{navy}}
  {\thesection}{0.5em}{}[{\color{gold}\titlerule[1.2pt]}]
\titleformat{\subsection}
  {\bfseries\large\color{teal}}
  {\thesubsection}{0.5em}{}
\titleformat{\subsubsection}
  {\bfseries\normalsize\color{darkslate}}
  {\thesubsubsection}{0.5em}{}

% ==============================================================================
% 6. RUNNING HEADERS & FOOTERS (fancyhdr)
% ==============================================================================
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.8pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{teal}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0.4pt}

% Default metadata hooks
\newcommand{\CourseCode}{CSE 1143}
\newcommand{\CourseTitle}{Discrete Mathematics}
\newcommand{\TopicTitle}{Study Handbook}
\newcommand{\AuthorName}{Suleman Ahmed Shuvo}
\newcommand{\setCourseInfo}[3]{%
  \renewcommand{\CourseCode}{#1}%
  \renewcommand{\CourseTitle}{#2}%
  \renewcommand{\TopicTitle}{#3}%
}
\newcommand{\setAuthorName}[1]{\renewcommand{\AuthorName}{#1}}

\fancyhead[L]{\small\bfseries\color{navy} \CourseCode: \CourseTitle}
\fancyhead[R]{\small\bfseries\color{teal} \TopicTitle}
\fancyfoot[L]{\footnotesize\color{gray} \AuthorName}
\fancyfoot[R]{\footnotesize\bfseries\color{navy} Page \thepage}

% ==============================================================================
% 7. THE 6 SIGNATURE TCOLORBOX ENVIRONMENTS
% ==============================================================================

% 1) Definition Box (Formal mathematical definition)
\newtcolorbox{defbox}[1][Definition]{
  colback=lightteal, colframe=teal, coltitle=white,
  fonttitle=\bfseries\small, colbacktitle=teal,
  title={#1},
  breakable, boxrule=0.8pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=6pt, after skip=6pt
}

% 2) Example Box (Concrete grounding & real-world illustrations)
\newtcolorbox{examplebox}[1][Concrete Example]{
  colback=lightgold, colframe=gold, coltitle=navy,
  fonttitle=\bfseries\small, colbacktitle=lightgold,
  title={#1},
  breakable, boxrule=0.8pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=6pt, after skip=6pt
}

% 3) Theorem / Proof Box (Formal proofs, derivations & systems relevance)
\newtcolorbox{theorembox}[1][Proof \& Derivation]{
  colback=white, colframe=navy, coltitle=white,
  fonttitle=\bfseries\small, colbacktitle=navy,
  title={#1},
  breakable, boxrule=1pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=6pt, after skip=6pt
}

% 4) Warning Box (Beginner traps, non-examples & exam pitfalls)
\newtcolorbox{warningbox}[1][Beginner Trap \& Pitfall Alert]{
  colback=lightcoral, colframe=coral, coltitle=white,
  fonttitle=\bfseries\small, colbacktitle=coral,
  title={#1},
  breakable, boxrule=0.9pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=6pt, after skip=6pt
}

% 5) Note Box (Key takeaways, chapter reviews & reminders)
\newtcolorbox{notebox}[1][Key Takeaway / Summary]{
  colback=navy!5, colframe=navy!70, coltitle=white,
  fonttitle=\bfseries\small, colbacktitle=navy!70,
  title={#1},
  breakable, boxrule=0.7pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=6pt, after skip=6pt
}

% 6) Exam Box (Dual-compartment Question & Answer with gold divider rule)
\newtcolorbox{exambox}[2][]{
  colback=white, colbacklower=teal!6, colframe=navy!90, coltitle=white,
  fonttitle=\bfseries\small, colbacktitle=navy!90,
  title={#2},
  breakable, boxrule=0.9pt, arc=3pt,
  left=8pt, right=8pt, top=5pt, bottom=6pt,
  before skip=5pt, after skip=5pt,
  lower separated=true, borderline horizontal={0.6pt}{0pt}{gold},
  #1
}
\newcommand{\Qlabel}{\textbf{\color{navy}\footnotesize\MakeUppercase{Question}}\par\smallskip}
\newcommand{\Alabel}{\textbf{\color{teal}\footnotesize\MakeUppercase{Answer}}\par\smallskip}

% ==============================================================================
% 8. SYLLABUS & METADATA CALLOUT HELPERS
% ==============================================================================

% Tutorial Test / Exam Syllabus Callout Box
\newenvironment{syllabusbox}[2][$\bigstar$ SEC TT Syllabus Guide]{%
  \begin{tcolorbox}[
    enhanced,
    colback=lightteal,
    colframe=teal,
    boxrule=0.8pt,
    arc=3pt,
    left=8pt, right=8pt, top=5pt, bottom=5pt
  ]
  \textbf{\color{navy}\normalsize #1}\\[2pt]
  {\footnotesize\textbf{\color{teal}#2} $\bullet$ \textbf{Dept. of Computer Science \& Engineering}}\\[2pt]
}{%
  \end{tcolorbox}
  \vspace{4pt}
}

% Publication Metadata Card
\newcommand{\makeMetadataCard}[5]{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=navy!30,
    boxrule=0.8pt,
    arc=4pt,
    left=16pt, right=16pt, top=14pt, bottom=14pt,
    shadow={2pt}{-2pt}{0pt}{black!10}
  ]
    \renewcommand{\arraystretch}{1.3}
    \begin{tabularx}{\linewidth}{@{}l X@{}}
      \textbf{\color{navy}\small COMPILED BY:} & {\large\bfseries\color{navy} #1} \\
      \textbf{\color{navy}\small ACADEMIC ID:} & {\small\color{darkslate} #2} \\
      \textbf{\color{navy}\small COURSE:} & {\small\color{teal}\bfseries #3} \\
      \textbf{\color{navy}\small DEPARTMENT:} & {\small Dept. of Computer Science \& Engineering} \\
      \textbf{\color{navy}\small INSTITUTION:} & {\small\bfseries #4} \\
      & {\footnotesize #5} \\
    \end{tabularx}
  \end{tcolorbox}
}

% Backward-compatibility aliases for generic box names
\newenvironment{infobox}[1]{\begin{defbox}[#1]}{\end{defbox}}
\newenvironment{successbox}[1]{\begin{examplebox}[#1]}{\end{examplebox}}
\newenvironment{theorystbox}[1]{\begin{theorembox}[#1]}{\end{theorembox}}
\newenvironment{dangerbox}[1]{\begin{warningbox}[#1]}{\end{warningbox}}

\endinput
